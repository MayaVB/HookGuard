# Copy to .env (git-ignored) and set real passwords:  cp .env.example .env
# docker compose reads .env automatically.

HOOKGUARD_DB_USER=hookguard
HOOKGUARD_DB_PASSWORD=change-me
HOOKGUARD_RABBIT_USER=hookguard
HOOKGUARD_RABBIT_PASSWORD=change-me

# Number of concurrent delivery consumers per worker process.
HOOKGUARD_WORKER_CONCURRENCY=4
